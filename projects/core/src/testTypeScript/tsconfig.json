{
  "$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "cc-corelib/*": ["packages/cc-corelib/*"],
      "soteria": ["packages/soteria/index.ts"]
    },
    "strict": false,
    "types": [
      "@jackmacwindows/lua-types/cc",
      "@siredvin/craftos-types",
      "@siredvin/cc-types",
      "@siredvin/api-types"
    ]
  },
  "tstl": {
    "luaTarget": "5.1",
    "luaLibImport": "inline",
    "sourceMapTraceback": false,
    "noResolvePaths": ["cc.expect"]
  },
  "include": ["src/**/*.ts", "packages/**/*.ts"]
}
